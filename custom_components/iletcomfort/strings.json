  "issues": {
    "device_offline": {
      "title": "Heat pump appears offline",
      "description": "Home Assistant has been receiving empty responses from device `{appliance_code}` for several minutes, so entities are showing the last known values. This usually means the heat pump has lost its connection to the iLetComfort cloud, or has been powered off. Check the device in the official iLetComfort / BTRI mobile app — if it shows as offline there too, the issue is on the device or vendor cloud side, not Home Assistant. The card will clear automatically once the device starts responding again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "iLetComfort options",
        "description": "Choose which client owns the cloud account session. HA primary keeps the existing polling and control behavior. Read-only keeps normal polling but blocks all HA control commands for testing. Phone app coexistence uses read-only MQTT push so the official app can remain signed in.",
